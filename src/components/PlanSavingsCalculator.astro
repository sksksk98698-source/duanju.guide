---
import { LINKS } from '../config/links'
import gsyData from '../data/gsy.json'
---

<div class="my-8 rounded-2xl border border-teal-200 bg-white p-6 sm:p-8 shadow-sm dark:border-teal-900/50 dark:bg-gray-900" id="savings-calculator">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-4 dark:border-gray-800">
    <div>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-900 mb-1">
        💡 智能选型交互工具
      </span>
      <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white">
        光速云套餐测算与省钱计算器 (2026 实时核算)
      </h3>
    </div>
    <span class="text-xs text-gray-500 dark:text-gray-400">
      官方资料核实：{gsyData.verifiedDate}
    </span>
  </div>

  <p class="mt-3 text-xs sm:text-sm text-gray-600 dark:text-gray-300">
    根据您的日常看剧频率、设备数量与使用周期，系统将自动匹配性价比最高的套餐并计算叠加 <strong>{gsyData.referral.code}</strong> 优惠码后的真实到手价。
  </p>

  <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Left inputs -->
    <div class="space-y-5">
      <!-- 1. 观剧场景 -->
      <div>
        <label class="block text-xs font-bold text-gray-700 dark:text-gray-200 uppercase tracking-wider mb-2">
          1. 预计月度追剧与使用强度
        </label>
        <div class="grid grid-cols-3 gap-2" id="calc-usage-group">
          <button
            type="button"
            data-usage="light"
            class="calc-opt-btn active px-3 py-2.5 rounded-xl border text-xs font-semibold transition-all text-center border-teal-500 bg-teal-50 text-teal-700 dark:bg-teal-950/60 dark:text-teal-300 dark:border-teal-600"
          >
            轻度看剧
            <span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400 mt-0.5">&lt;50G/月</span>
          </button>
          <button
            type="button"
            data-usage="medium"
            class="calc-opt-btn px-3 py-2.5 rounded-xl border text-xs font-semibold transition-all text-center border-gray-200 text-gray-700 bg-gray-50 hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700"
          >
            中度追剧
            <span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400 mt-0.5">100G-200G/月</span>
          </button>
          <button
            type="button"
            data-usage="heavy"
            class="calc-opt-btn px-3 py-2.5 rounded-xl border text-xs font-semibold transition-all text-center border-gray-200 text-gray-700 bg-gray-50 hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700"
          >
            重度/多端
            <span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400 mt-0.5">300G+/月</span>
          </button>
        </div>
      </div>

      <!-- 2. 计费周期 -->
      <div>
        <label class="block text-xs font-bold text-gray-700 dark:text-gray-200 uppercase tracking-wider mb-2">
          2. 选购付费周期 (周期越长折扣越高)
        </label>
        <div class="grid grid-cols-3 gap-2" id="calc-cycle-group">
          <button
            type="button"
            data-cycle="month"
            class="calc-cycle-btn px-3 py-2.5 rounded-xl border text-xs font-semibold transition-all text-center border-gray-200 text-gray-700 bg-gray-50 hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700"
          >
            按月订购
            <span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400 mt-0.5">无基础折扣</span>
          </button>
          <button
            type="button"
            data-cycle="year"
            class="calc-cycle-btn active px-3 py-2.5 rounded-xl border text-xs font-semibold transition-all text-center border-teal-500 bg-teal-50 text-teal-700 dark:bg-teal-950/60 dark:text-teal-300 dark:border-teal-600"
          >
            按年订购 (推荐)
            <span class="block text-[10px] font-normal text-teal-600 dark:text-teal-400 mt-0.5">官方直降20%</span>
          </button>
          <button
            type="button"
            data-cycle="triennial"
            class="calc-cycle-btn px-3 py-2.5 rounded-xl border text-xs font-semibold transition-all text-center border-gray-200 text-gray-700 bg-gray-50 hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700"
          >
            三年长周期
            <span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400 mt-0.5">官方直降30%</span>
          </button>
        </div>
      </div>

      <!-- 3. 优惠券叠加勾选 -->
      <div class="flex items-center gap-2 p-3 rounded-xl bg-teal-50/50 border border-teal-100 dark:bg-teal-950/20 dark:border-teal-900/60">
        <input
          type="checkbox"
          id="calc-coupon-toggle"
          checked
          class="h-4 w-4 rounded border-gray-300 text-teal-600 focus:ring-teal-500 cursor-pointer"
        />
        <label for="calc-coupon-toggle" class="text-xs text-gray-700 dark:text-gray-300 cursor-pointer select-none">
          叠加专属优惠码 <strong class="text-teal-700 dark:text-teal-300 font-mono">{gsyData.referral.code}</strong> (结账额外打 8 折)
        </label>
      </div>
    </div>

    <!-- Right Result Card -->
    <div class="rounded-xl border border-teal-300 bg-gradient-to-b from-teal-50/80 via-white to-gray-50 p-6 flex flex-col justify-between dark:from-teal-950/40 dark:via-gray-900 dark:to-gray-900 dark:border-teal-800">
      <div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-gray-500 dark:text-gray-400">为您智能匹配方案：</span>
          <span id="calc-plan-badge" class="px-2 py-0.5 text-xs font-bold rounded bg-teal-600 text-white">
            极速版 (IEPL 内网专线)
          </span>
        </div>

        <h4 id="calc-plan-title" class="text-xl font-extrabold text-gray-900 dark:text-white mt-2">
          光速云 极速版 (推荐日常与高频追剧)
        </h4>

        <p id="calc-plan-desc" class="text-xs text-gray-600 dark:text-gray-400 mt-1 leading-relaxed">
          包含港台日新美等 11 国原生专线节点，200GB/月高速流量，单节点最高 2.5Gbps 带宽，不限设备数量同时在线。
        </p>

        <!-- Pricing Highlight -->
        <div class="mt-5 p-4 rounded-xl bg-white border border-teal-100 shadow-sm dark:bg-gray-800 dark:border-gray-700">
          <div class="flex items-baseline justify-between">
            <span class="text-xs text-gray-500 dark:text-gray-400">核算到手总价：</span>
            <div class="text-right">
              <span id="calc-price-original" class="text-xs text-gray-400 line-through mr-1.5">¥276.00</span>
              <span id="calc-price-final" class="text-2xl font-extrabold text-teal-600 dark:text-teal-400">¥176.64</span>
              <span id="calc-price-unit" class="text-xs text-gray-500 dark:text-gray-400"> / 年</span>
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-gray-100 flex items-center justify-between text-xs dark:border-gray-700">
            <span class="text-gray-500 dark:text-gray-400">折合月费约：</span>
            <strong id="calc-price-monthly" class="text-teal-700 dark:text-teal-300 font-bold">
              ¥14.72 / 月
            </strong>
          </div>
          <div class="mt-1 flex items-center justify-between text-xs text-rose-500 dark:text-rose-400 font-semibold">
            <span>叠加优惠立省：</span>
            <span id="calc-savings-amount">¥99.36</span>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="mt-6 space-y-2">
        <a
          href={LINKS.gsyAffiliate}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 text-sm font-bold text-white bg-teal-600 hover:bg-teal-700 rounded-xl shadow-md transition-all hover:scale-[1.01] active:scale-95 cursor-pointer"
        >
          <span>立即前往官网按此优惠订购</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <div class="flex items-center justify-between text-[11px] text-gray-400 px-1">
          <span>结账时请务必填写优惠码：<strong class="text-teal-600 dark:text-teal-400 font-mono">{gsyData.referral.code}</strong></span>
          <span>[含推广链接]</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initCalculator() {
    const usageBtns = document.querySelectorAll('#calc-usage-group button')
    const cycleBtns = document.querySelectorAll('#calc-cycle-group button')
    const couponToggle = document.getElementById('calc-coupon-toggle') as HTMLInputElement | null

    const planBadge = document.getElementById('calc-plan-badge')
    const planTitle = document.getElementById('calc-plan-title')
    const planDesc = document.getElementById('calc-plan-desc')
    const priceOrig = document.getElementById('calc-price-original')
    const priceFinal = document.getElementById('calc-price-final')
    const priceUnit = document.getElementById('calc-price-unit')
    const priceMonthly = document.getElementById('calc-price-monthly')
    const savingsAmount = document.getElementById('calc-savings-amount')

    if (!usageBtns.length || !cycleBtns.length) return

    let currentUsage = 'medium'
    let currentCycle = 'year'
    let useCoupon = true

    function updateView() {
      // 1. Determine recommended plan
      // Light plan: 99 RMB/year flat (59GB/month), light usage only
      // Standard plan: 23 RMB/month base (200GB/month)
      // Cycle discounts: month (1.0), year (0.8), triennial (0.7)
      // Coupon AMM: 0.8
      
      let isLight = currentUsage === 'light' && currentCycle === 'year'
      
      let baseOriginal = 0
      let discountedTotal = 0
      let monthlyRate = 0
      let unitText = ' / 月'
      let planName = ''
      let badgeText = ''
      let descText = ''

      if (isLight) {
        planName = '光速云 轻量版 (专为轻度追剧打造)'
        badgeText = '性价比轻量版'
        descText = '包含 59GB/月高速专线流量，全节点 1 倍率，月均折合仅需 8.25 元，极为适合单人轻度看剧。'
        baseOriginal = 99.0
        // Light version usually fixed 99/year; with coupon 80% = 79.2
        discountedTotal = useCoupon ? 99.0 * 0.8 : 99.0
        monthlyRate = discountedTotal / 12
        unitText = ' / 年'
      } else {
        planName = '光速云 极速版 (推荐日常与高频追剧)'
        badgeText = '极速版 (IEPL 专线)'
        descText = '包含港台日新美等 11 国原生专线节点，200GB/月高速流量，单节点最高 2.5Gbps 带宽，不限设备数量同时在线。'

        const baseMonthPrice = 23.0
        let months = 1
        let cycleDiscount = 1.0

        if (currentCycle === 'month') {
          months = 1
          cycleDiscount = 1.0
          unitText = ' / 月'
        } else if (currentCycle === 'year') {
          months = 12
          cycleDiscount = 0.8 // 官方年付 8 折
          unitText = ' / 年'
        } else if (currentCycle === 'triennial') {
          months = 36
          cycleDiscount = 0.7 // 官方三年付 7 折
          unitText = ' / 3年'
        }

        baseOriginal = baseMonthPrice * months
        const cycleTotal = baseOriginal * cycleDiscount
        discountedTotal = useCoupon ? cycleTotal * 0.8 : cycleTotal
        monthlyRate = discountedTotal / months
      }

      const saved = baseOriginal - discountedTotal

      if (planTitle) planTitle.textContent = planName
      if (planBadge) planBadge.textContent = badgeText
      if (planDesc) planDesc.textContent = descText
      if (priceOrig) priceOrig.textContent = `¥${baseOriginal.toFixed(2)}`
      if (priceFinal) priceFinal.textContent = `¥${discountedTotal.toFixed(2)}`
      if (priceUnit) priceUnit.textContent = unitText
      if (priceMonthly) priceMonthly.textContent = `¥${monthlyRate.toFixed(2)} / 月`
      if (savingsAmount) savingsAmount.textContent = `¥${saved.toFixed(2)}`
    }

    usageBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        usageBtns.forEach((b) => {
          b.classList.remove('border-teal-500', 'bg-teal-50', 'text-teal-700', 'dark:bg-teal-950/60', 'dark:text-teal-300', 'dark:border-teal-600')
          b.classList.add('border-gray-200', 'text-gray-700', 'bg-gray-50', 'dark:bg-gray-800', 'dark:text-gray-300', 'dark:border-gray-700')
        })
        btn.classList.add('border-teal-500', 'bg-teal-50', 'text-teal-700', 'dark:bg-teal-950/60', 'dark:text-teal-300', 'dark:border-teal-600')
        btn.classList.remove('border-gray-200', 'text-gray-700', 'bg-gray-50', 'dark:bg-gray-800', 'dark:text-gray-300', 'dark:border-gray-700')
        currentUsage = btn.getAttribute('data-usage') || 'medium'
        updateView()
      })
    })

    cycleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        cycleBtns.forEach((b) => {
          b.classList.remove('border-teal-500', 'bg-teal-50', 'text-teal-700', 'dark:bg-teal-950/60', 'dark:text-teal-300', 'dark:border-teal-600')
          b.classList.add('border-gray-200', 'text-gray-700', 'bg-gray-50', 'dark:bg-gray-800', 'dark:text-gray-300', 'dark:border-gray-700')
        })
        btn.classList.add('border-teal-500', 'bg-teal-50', 'text-teal-700', 'dark:bg-teal-950/60', 'dark:text-teal-300', 'dark:border-teal-600')
        btn.classList.remove('border-gray-200', 'text-gray-700', 'bg-gray-50', 'dark:bg-gray-800', 'dark:text-gray-300', 'dark:border-gray-700')
        currentCycle = btn.getAttribute('data-cycle') || 'year'
        updateView()
      })
    })

    if (couponToggle) {
      couponToggle.addEventListener('change', () => {
        useCoupon = couponToggle.checked
        updateView()
      })
    }

    updateView()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalculator)
  } else {
    initCalculator()
  }
</script>
