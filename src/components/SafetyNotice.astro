---
interface Props {
  type?: 'warning' | 'info' | 'adult'
  title?: string
  content?: string
}

const {
  type = 'warning',
  title = '安全与合规警示',
  content = '请务必通过官方正规渠道了解平台信息，切勿轻信非官方群聊或网盘分享的所谓“破解版、免充值安装包”，谨防恶意木马与财产损失。',
} = Astro.props
---

<div class={`my-6 rounded-xl border p-4 text-xs sm:text-sm leading-relaxed ${
  type === 'warning'
    ? 'border-amber-200 bg-amber-50/70 text-amber-900 dark:bg-amber-950/30 dark:border-amber-900 dark:text-amber-200'
    : type === 'adult'
    ? 'border-rose-200 bg-rose-50/70 text-rose-900 dark:bg-rose-950/30 dark:border-rose-900 dark:text-rose-200'
    : 'border-blue-200 bg-blue-50/70 text-blue-900 dark:bg-blue-950/30 dark:border-blue-900 dark:text-blue-200'
}`}>
  <div class="flex items-start gap-2.5">
    <div class="shrink-0 mt-0.5 font-bold">
      {type === 'warning' && '⚠️'}
      {type === 'adult' && '🔞'}
      {type === 'info' && 'ℹ️'}
    </div>
    <div>
      <div class="font-bold mb-1">{title}</div>
      <div class="opacity-90">{content}</div>
      <slot />
    </div>
  </div>
</div>
