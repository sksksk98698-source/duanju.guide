---
interface Props {
  title: string
  description: string
  href: string
  tag?: string
  badge?: string
  date?: string
  icon?: string
}

const { title, description, href, tag, badge, date } = Astro.props
---

<a
  href={href}
  class="card group relative flex flex-col justify-between p-5 sm:p-6 no-underline text-inherit"
>
  <div>
    <!-- Header tags/badges -->
    {
      (tag || badge) && (
        <div class="flex items-center justify-between gap-2 mb-3">
          {tag && (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-teal-50 text-teal-700 border border-teal-200 dark:bg-teal-950/60 dark:text-teal-300 dark:border-teal-900">
              {tag}
            </span>
          )}
          {badge && (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-900">
              {badge}
            </span>
          )}
        </div>
      )
    }

    <!-- Title -->
    <h3 class="text-base sm:text-lg font-bold text-gray-900 group-hover:text-teal-600 transition-colors dark:text-white dark:group-hover:text-teal-400">
      {title}
    </h3>

    <!-- Description -->
    <p class="mt-2 text-xs sm:text-sm leading-relaxed text-gray-600 dark:text-gray-400 line-clamp-3">
      {description}
    </p>
  </div>

  <!-- Footer link indicator & date -->
  <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400 dark:border-gray-800">
    {date ? <span>{date}</span> : <span class="text-teal-600 font-medium group-hover:underline dark:text-teal-400">阅读排查指引 →</span>}
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform group-hover:translate-x-1 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
