---
import { LINKS } from '../config/links'
---

<div
  id="rescue-modal"
  class="fixed bottom-20 right-4 z-40 max-w-sm w-full bg-white dark:bg-gray-900 border-2 border-teal-500 rounded-2xl shadow-2xl p-5 transform transition-all duration-500 translate-y-12 opacity-0 pointer-events-none"
  role="dialog"
  aria-label="短剧排查播放急救方案"
>
  <!-- Top Badge & Close -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-1.5">
      <span class="inline-flex h-2.5 w-2.5 rounded-full bg-rose-500 animate-ping"></span>
      <span class="text-xs font-extrabold text-teal-700 dark:text-teal-400 uppercase tracking-wide">
        短剧排查急救方案
      </span>
      <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-amber-100 text-amber-900 border border-amber-300 dark:bg-amber-950 dark:text-amber-200">
        含推广
      </span>
    </div>
    <button
      id="close-rescue-btn"
      type="button"
      class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-sm leading-none p-1 cursor-pointer"
      aria-label="关闭急救弹窗"
    >
      ✕
    </button>
  </div>

  <!-- Body -->
  <h4 class="mt-2.5 text-sm sm:text-base font-extrabold text-gray-900 dark:text-white leading-snug">
    排查多步依然无法播放？
  </h4>
  <p class="mt-1.5 text-xs text-gray-600 dark:text-gray-300 leading-relaxed">
    由于黄果短剧服务器位于海外，<strong>普通国内宽带直连 100% 遭遇版权地域阻断或晚高峰国际高丢包</strong>。配置专线中转是恢复顺畅观看的底层前提。
  </p>

  <!-- Highlight box -->
  <div class="mt-3 rounded-lg bg-teal-50 dark:bg-teal-950/50 border border-teal-200 dark:border-teal-900 p-2.5 flex items-center justify-between text-xs">
    <span class="text-teal-900 dark:text-teal-200 font-medium">推荐：光速云 IEPL 专线</span>
    <span class="font-mono font-bold text-teal-700 dark:text-teal-300 bg-teal-100 dark:bg-teal-900 px-1.5 py-0.5 rounded">
      码 AMM 享8折
    </span>
  </div>

  <!-- CTA Buttons -->
  <div class="mt-4 flex items-center gap-2">
    <a
      href={LINKS.GSY_REGISTER}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="flex-1 text-center py-2 px-3 text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 rounded-lg shadow-sm transition-colors"
    >
      获取专线方案 →
    </a>
    <a
      href="/gsy/pricing/plan-comparison-guide/"
      class="py-2 px-3 text-xs font-semibold text-gray-700 hover:text-teal-600 dark:text-gray-300 rounded-lg border border-gray-200 dark:border-gray-700 transition-colors"
    >
      了解资费
    </a>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('rescue-modal')
    const closeBtn = document.getElementById('close-rescue-btn')
    let hasShown = false
    let isDismissed = sessionStorage.getItem('rescue_dismissed') === 'true'

    if (isDismissed) return

    const handleScroll = () => {
      if (hasShown || isDismissed) return
      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight
      if (scrollTotal <= 0) return
      const scrollPercent = (window.scrollY / scrollTotal) * 100

      // Trigger when user scrolls past 40% of the troubleshooting guide
      if (scrollPercent >= 40) {
        hasShown = true
        modal?.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none')
        modal?.classList.add('translate-y-0', 'opacity-100')
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true })

    closeBtn?.addEventListener('click', () => {
      isDismissed = true
      sessionStorage.setItem('rescue_dismissed', 'true')
      modal?.classList.remove('translate-y-0', 'opacity-100')
      modal?.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none')
    })
  })
</script>
