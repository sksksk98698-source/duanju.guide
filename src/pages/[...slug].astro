---
import { getCollection, render } from 'astro:content'
import ArticleLayout from '../layouts/ArticleLayout.astro'
import ProblemLayout from '../layouts/ProblemLayout.astro'

export async function getStaticPaths() {
  const guideEntries = await getCollection('guide')
  const problemsEntries = await getCollection('problems')
  const compareEntries = await getCollection('compare')
  const gsyEntries = await getCollection('gsy')
  const aboutEntries = await getCollection('about')

  const paths = [
    ...guideEntries.map((entry) => ({
      params: { slug: `guide/${entry.id}` },
      props: { entry, collectionName: 'guide' },
    })),
    ...problemsEntries.map((entry) => ({
      params: { slug: `problems/${entry.id}` },
      props: { entry, collectionName: 'problems' },
    })),
    ...compareEntries.map((entry) => ({
      params: { slug: `compare/${entry.id}` },
      props: { entry, collectionName: 'compare' },
    })),
    ...gsyEntries.map((entry) => ({
      params: { slug: `gsy/${entry.id}` },
      props: { entry, collectionName: 'gsy' },
    })),
    ...aboutEntries.map((entry) => ({
      params: { slug: `about/${entry.id}` },
      props: { entry, collectionName: 'about' },
    })),
  ]

  return paths
}

const { entry, collectionName } = Astro.props
const { Content, headings } = await render(entry)

// Category name mapping
const categoryNameMap: Record<string, string> = {
  guide: '入口与教程',
  problems: '访问问题解决',
  compare: '对比与安全',
  gsy: '光速云专区',
  about: '关于与合规',
}

const currentCategoryName = entry.data.categoryName || categoryNameMap[collectionName] || '文章指引'
const currentCategoryUrl = entry.data.categoryUrl || `/${collectionName}/`
---

{
  collectionName === 'problems' ? (
    <ProblemLayout
      title={entry.data.title}
      description={entry.data.description}
      pubDate={entry.data.pubDate}
      updatedDate={entry.data.updatedDate}
      cluster={entry.data.cluster}
      clusterName={entry.data.clusterName}
      keywords={entry.data.keywords}
    >
      <Content />
    </ProblemLayout>
  ) : (
    <ArticleLayout
      title={entry.data.title}
      description={entry.data.description}
      pubDate={entry.data.pubDate}
      updatedDate={entry.data.updatedDate}
      category={collectionName}
      categoryName={currentCategoryName}
      categoryUrl={currentCategoryUrl}
      keywords={entry.data.keywords}
      author={entry.data.author}
      showGSY={entry.data.showGSY ?? (collectionName === 'gsy')}
      cluster={entry.data.cluster}
      faq={entry.data.faq}
    >
      <Content />
    </ArticleLayout>
  )
}
