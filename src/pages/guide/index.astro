---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Card from '../../components/Card.astro'
import SafetyNotice from '../../components/SafetyNotice.astro'
import { SITE } from '../../consts'

const clusters = [
  {
    title: '1. 官网入口与防伪导航',
    slug: 'official-site',
    desc: '识别黄果短剧最新正规官方入口，防范山寨镜像与钓鱼木马风险。',
    articles: [
      {
        title: '2026黄果短剧官网入口导航：最新官方网页版地址与安全识别技巧',
        href: '/guide/official-site/latest-address-2026/',
        desc: '梳理2026年最新官方网页端登录地址，排查DNS解析异常与域名识别防走丢指南。',
        badge: '核心入口',
      },
      {
        title: '黄果短剧防伪防走丢指南：如何识别假冒钓鱼网站与恶意镜像',
        href: '/guide/official-site/anti-phishing-guide/',
        desc: '教你一眼识别山寨钓鱼页面、恶意注入广告与伪造SSL证书的风险防范。',
      },
      {
        title: '黄果短剧多端网页访问技巧：手机浏览器与电脑端访问差异解析',
        href: '/guide/official-site/multi-device-access/',
        desc: '移动端Safari/Chrome与PC端Edge浏览器观看设置，横竖屏与全屏体验调优。',
      },
    ],
  },
  {
    title: '2. 客户端下载与安装配置',
    slug: 'download',
    desc: '覆盖 iOS、Android 与桌面轻应用 (PWA) 的保姆级安全安装教程。',
    articles: [
      {
        title: '黄果短剧 iOS 客户端安装全攻略：TestFlight与企业签名防封教程',
        href: '/guide/download/ios-installation-steps/',
        desc: '苹果手机无法在国区商店搜索时的解决办法，企业签名未受信任与掉签应急处理。',
        badge: 'iOS必备',
      },
      {
        title: '黄果短剧 Android 客户端安装排错：APK安装包风险校验与权限配置',
        href: '/guide/download/android-apk-troubleshooting/',
        desc: '解决华为纯净模式拦截、小米安装解析包错误，最小化授权麦克风与通讯录。',
      },
      {
        title: '黄果短剧桌面轻应用 (PWA) 配置：无需安装客户端畅享全屏体验',
        href: '/guide/download/pwa-web-app-setup/',
        desc: '免下载安装包，通过浏览器快速添加网页捷径到手机主屏幕与电脑桌面。',
      },
    ],
  },
  {
    title: '3. 播放入门与优化技巧',
    slug: 'how-to-use',
    desc: '全功能操作流程、画质调整、省流量模式与本地缓存深度管理。',
    articles: [
      {
        title: '黄果短剧全功能操作指南：界面布局、追剧收藏与画质调节',
        href: '/guide/how-to-use/complete-beginners-guide/',
        desc: '新手必读：界面快速上手、倍速播放切换、剧集连播设置与历史记录查看。',
      },
      {
        title: '黄果短剧播放优化技巧：流畅度提升、省流模式与省电设置',
        href: '/guide/how-to-use/playback-optimization/',
        desc: '解决手机发烫、耗电严重与音画不同步，开启GPU硬件解码加速短剧加载。',
      },
      {
        title: '黄果短剧离线与缓存机制解析：存储管理与本地数据安全',
        href: '/guide/how-to-use/cache-management-guide/',
        desc: '短剧切片数据占满手机内存怎么清理？合理配置本地临时存储限额。',
      },
    ],
  },
  {
    title: '4. 账号注册与登录管理',
    slug: 'register',
    desc: '验证码收取失败、多设备同时在线限制与个人数据注销合规。',
    articles: [
      {
        title: '黄果短剧账号注册与登录流程：验证码接收失败全方位排查',
        href: '/guide/register/signup-login-troubleshooting/',
        desc: '短信验证码被拦截、提示网络错误或IP受限排查，快速找回密码方法。',
      },
      {
        title: '黄果短剧多设备登录规则：同时在线限制与会话管理',
        href: '/guide/register/multi-device-login-policy/',
        desc: '一个账号支持几台设备登录？平板和手机互踢下线排查与异地登录防盗。',
      },
      {
        title: '黄果短剧账号注销与个人数据安全清除指南',
        href: '/guide/register/account-deletion-privacy/',
        desc: '不看之后如何彻底注销账号并删除关联设备信息与浏览历史记录。',
      },
    ],
  },
  {
    title: '5. 资费与常见问题 (FAQ)',
    slug: 'faq',
    desc: '收费机制释疑、免广告策略与跨国跨境访问网络常识。',
    articles: [
      {
        title: '黄果短剧常见问题20问：收费机制、VIP充值与免广告政策释疑',
        href: '/guide/faq/billing-and-ad-policy/',
        desc: '平台是免费的吗？看广告能否解锁全集？充值金币规则与防坑指南。',
      },
      {
        title: '黄果短剧基础网络环境要求：带宽、丢包率与网络延迟标准',
        href: '/guide/faq/network-requirements-guide/',
        desc: '看1080P短剧需要多少兆宽带？Ping值多少不卡？三大运营商网络适配分析。',
      },
      {
        title: '黄果短剧跨国跨境访问须知：版权分发机制与服务区域规范',
        href: '/guide/faq/cross-border-access-regulations/',
        desc: '海外华人与留学生访问短剧版权限制说明，国际网络路由与分发原理。',
      },
    ],
  },
]

const canonicalUrl = new URL('/guide/', SITE.url).href
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: '入口与教程', item: canonicalUrl },
  ],
}
const collectionSchema = {
  '@type': 'CollectionPage',
  name: '黄果短剧入口与使用教程大全 (2026)',
  description: '黄果短剧入口与使用教程专区，包含最新官网地址防走丢导航、iOS与Android安装配置、全功能使用技巧及账号排错指南。',
  url: canonicalUrl,
  inLanguage: 'zh-CN',
}
const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbSchema, collectionSchema],
}
---

<BaseLayout
  title="黄果短剧入口与使用教程大全 (2026)"
  description="黄果短剧入口与使用教程专区，包含最新官网地址防走丢导航、iOS与Android安装配置、全功能使用技巧及账号排错指南。"
  keywords={['黄果短剧官网', '黄果短剧教程', '黄果短剧下载', '黄果短剧怎么用', '黄果短剧苹果版']}
  canonical={canonicalUrl}
  schemaData={schemaData}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <!-- Header -->
    <header class="border-b border-gray-100 pb-8 dark:border-gray-800">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-900">
          第一级导航
        </span>
        <span class="text-xs text-gray-400">共 15 篇全套教程</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight dark:text-white">
        黄果短剧入口导航与使用教程大全
      </h1>
      <p class="mt-3 text-base text-gray-600 dark:text-gray-300 max-w-3xl leading-relaxed">
        本专区汇集黄果短剧官方最新入口识别技巧、多终端客户端安装规范及操作进阶指南。如遇访问打不开、视频一直转圈等网络故障，请前往 <a href="/problems/" class="text-teal-600 font-semibold hover:underline">访问问题解决中心</a> 进行专项排错。
      </p>
    </header>

    <!-- 5 Clusters -->
    <div class="mt-10 space-y-12">
      {
        clusters.map((cluster) => (
          <section>
            <div class="mb-4">
              <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <span class="h-5 w-1.5 rounded-full bg-teal-600"></span>
                {cluster.title}
              </h2>
              <p class="text-xs sm:text-sm text-gray-500 mt-1 dark:text-gray-400">
                {cluster.desc}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              {cluster.articles.map((art) => (
                <Card
                  title={art.title}
                  description={art.desc}
                  href={art.href}
                  badge={art.badge}
                  tag={cluster.slug}
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- Troubleshooting Link Box (Funnel bridge to /problems/) -->
    <div class="mt-14 rounded-2xl border border-rose-200 bg-rose-50/50 p-6 sm:p-8 dark:bg-rose-950/20 dark:border-rose-900">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="inline-flex px-2 py-0.5 rounded text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-900 dark:text-rose-200 mb-2">
            ⚠️ 遇到了访问故障？
          </span>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">
            出现“打不开”、“地区限制”或“一直转圈”？
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 mt-1">
            普通宽带常因 DNS 污染或国际出口拥堵出现加载失败，请进入故障排查中心获取 6 步法解决方案。
          </p>
        </div>
        <a
          href="/problems/cant-open/dns-resolution-failure/"
          class="shrink-0 inline-flex items-center px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-xs transition-colors"
        >
          前往访问故障排查 →
        </a>
      </div>
    </div>

    <!-- Safety Notice -->
    <div class="mt-8">
      <SafetyNotice
        type="adult"
        title="观影合规提示"
        content="本站与黄果短剧官方不存在任何从属关系，不提供任何内容点播或盗版资源下载。未满18周岁未成年人严禁访问涉成人内容平台。"
      />
    </div>
  </div>
</BaseLayout>
