---
import BaseLayout from './BaseLayout.astro'
import { SITE } from '../consts'
import GSYCTA from '../components/GSYCTA.astro'
import SafetyNotice from '../components/SafetyNotice.astro'
import DirectVsProxyComparison from '../components/DirectVsProxyComparison.astro'
import StickyCTA from '../components/StickyCTA.astro'
import RescueModal from '../components/RescueModal.astro'

interface Props {
  title: string
  description: string
  pubDate?: string
  updatedDate?: string
  cluster?: string
  clusterName?: string
  keywords?: string[]
}

const {
  title,
  description,
  pubDate = '2026-03-01',
  updatedDate = '2026-09-30',
  cluster = 'cant-open',
  clusterName = '打不开排查',
  keywords = [],
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href

// BreadcrumbList Schema
const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '访问问题解决', url: '/problems/' },
  { name: title, url: Astro.url.pathname },
]

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.url, SITE.url).href,
  })),
}

// Article Schema
const articleSchema = {
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: pubDate,
  dateModified: updatedDate,
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Organization',
    name: '黄果短剧网络应急小组',
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}/logo.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
}

// FAQ / Troubleshooting Schema for Quick Google SERP Rich Snippets
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: title,
      acceptedAnswer: {
        '@type': 'Answer',
        text: description,
      },
    },
  ],
}

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbSchema, articleSchema, faqSchema],
}
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonicalUrl}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  schemaData={combinedSchema}
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-gray-500 mb-6 flex-wrap" aria-label="Breadcrumb">
      {
        breadcrumbs.map((crumb, idx) => (
          <div class="flex items-center gap-1.5">
            {idx > 0 && <span class="text-gray-300 dark:text-gray-700">/</span>}
            {idx === breadcrumbs.length - 1 ? (
              <span class="text-gray-800 font-medium dark:text-gray-200 line-clamp-1 max-w-[200px] sm:max-w-none">
                {crumb.name}
              </span>
            ) : (
              <a href={crumb.url} class="hover:text-teal-600 transition-colors dark:hover:text-teal-400">
                {crumb.name}
              </a>
            )}
          </div>
        ))
      }
    </nav>

    <!-- Header Diagnostic Header -->
    <header class="border-b border-gray-100 pb-8 dark:border-gray-800">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <a
          href="/problems/"
          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 dark:bg-rose-950 dark:text-rose-300 dark:border-rose-900"
        >
          故障排查与恢复
        </a>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
          分类：{clusterName}
        </span>
        <span class="text-xs text-gray-400">已核实有效：{updatedDate}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight dark:text-white leading-tight">
        {title}
      </h1>

      <!-- Fast diagnostic summary box with essential prerequisite -->
      <div class="mt-5 rounded-xl border-2 border-teal-500/40 bg-teal-50/60 p-4 sm:p-5 text-xs sm:text-sm text-teal-950 dark:bg-teal-950/40 dark:border-teal-800 dark:text-teal-200">
        <div class="font-extrabold flex items-center gap-1.5 mb-1.5 text-teal-800 dark:text-teal-300">
          <span>⚡</span> 快速排查结论与核心网络前提
        </div>
        <p class="leading-relaxed mb-3">
          {description}
        </p>
        <div class="pt-3 border-t border-teal-200/60 dark:border-teal-900/60 text-[11px] sm:text-xs text-teal-900 dark:text-teal-300/90 flex items-start gap-1.5">
          <span class="text-teal-600 font-bold shrink-0">💡 刚需须知：</span>
          <span>由于黄果短剧服务器部署于海外节点，国内普通宽带直接访问会被识别为非授权区域并遭遇国际路由高丢包阻断，<strong>配置海外商业专线网络（如光速云）是顺畅播放的底层保障</strong>。</span>
        </div>
      </div>
    </header>

    <!-- Article 6-step GEO body -->
    <article class="prose prose-slate max-w-none py-8 dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-a:text-teal-600 hover:prose-a:text-teal-700">
      <slot />
    </article>

    <!-- Visual Comparison Card -->
    <DirectVsProxyComparison />

    <!-- Natural Solution CTA: GSY -->
    <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800">
      <GSYCTA
        variant="card"
        title="根本解决：配置商业级专线网络保障访问"
        description="遇到短剧打不开、频繁转圈或地区限制，往往是由于国际出口丢包与DNS污染所致。光速云提供IEPL内网专线与高洁净度节点，从根源消除网络阻断。"
        buttonText="查看光速云网络方案 (含推广) →"
      />
    </div>

    <!-- Safety Notice -->
    <SafetyNotice
      type="warning"
      title="安全防范提示"
      content="切勿使用来源不明的免费公共代理或破解工具，谨防个人账号凭据、Cookie 与隐私数据被窃取。"
    />
  </div>

  <!-- Sticky Bottom CTA -->
  <StickyCTA />

  <!-- 50% Scroll Rescue Modal -->
  <RescueModal />
</BaseLayout>
